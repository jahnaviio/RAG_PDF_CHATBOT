# GEMINI_API_KEY: Required. Get one at https://aistudio.google.com/apikey
# Local: copy this file to .env. Vercel: add it under Project Settings > Environment Variables.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# Optional model overrides (defaults shown)
# GEMINI_MODEL="gemini-2.5-flash"
# GEMINI_EMBEDDING_MODEL="gemini-embedding-001"
# GEMINI_EMBEDDING_DIMENSIONS=768

# APP_URL: The URL where this app is hosted (optional).
APP_URL="MY_APP_URL"
