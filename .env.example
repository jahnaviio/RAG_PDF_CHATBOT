# ---------- Required ----------
# Gemini key: https://aistudio.google.com/apikey
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# Neon Postgres connection string (Vercel: Storage > Neon adds this automatically as DATABASE_URL)
DATABASE_URL="postgres://user:password@ep-xxxx.neon.tech/neondb?sslmode=require"

# Google login: OAuth "Web application" client ID (see README, step 2)
GOOGLE_CLIENT_ID="1234567890-xxxx.apps.googleusercontent.com"

# Random secret used to sign login cookies. Generate one:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
AUTH_SECRET="replace-with-a-long-random-string"

# ---------- Optional ----------
# ADMIN_EMAILS="you@gmail.com"        # who may open /api/metrics
# DAILY_MESSAGE_LIMIT=60              # per user, rolling 24h (protects your Gemini quota)
# MAX_DOCS_PER_USER=15
# DAILY_CHUNK_LIMIT=2500              # chunks a user may index per 24h
# ENABLE_RERANK=false                 # LLM reranking after hybrid search (better, slower, costs one extra call)

# GEMINI_MODEL="gemini-2.5-flash"
# GEMINI_EMBEDDING_MODEL="gemini-embedding-001"
# GEMINI_EMBEDDING_DIMENSIONS=768     # don't change after the tables exist
